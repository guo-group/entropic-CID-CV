LAMMPS (22 Jul 2025 - Update 2)
# LAMMPS input for LJ binary mixture with Widom insertion
# Equal sigma, different epsilon

# Initialize
units           lj
atom_style      atomic
boundary        p p p

# Create simulation box
lattice         fcc 0.8
Lattice spacing in x,y,z = 1.7099759 1.7099759 1.7099759
region          box block 0 15 0 15 0 15
create_box      2 box
Created orthogonal box = (0 0 0) to (25.649639 25.649639 25.649639)
  2 by 2 by 2 MPI processor grid
create_atoms    1 box
Created 13500 atoms
  using lattice units in orthogonal box = (0 0 0) to (25.649639 25.649639 25.649639)
  create_atoms CPU = 0.002 seconds

# Set masses (both equal to 1.0 in reduced units)
mass            1 1.0
mass            2 1.0

# Set up 50:50 mixture
set             group all type/fraction 2 0.5 12345
Setting atom values ...
  6702 settings made for type/fraction

# Define groups
group           typeA type 1
6798 atoms in group typeA
group           typeB type 2
6702 atoms in group typeB

# LJ parameters
pair_style      lj/cut 3.0
pair_modify     tail yes
pair_coeff      1 1 0.8 1.0    # A-A interaction
pair_coeff      2 2 1.2 1.0    # B-B interaction
pair_coeff      1 2 0.2 1.0 # A-B interaction

# Initial velocities
velocity        all create 5.0 22222 dist gaussian

# Neighbor list
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

# Time integration (NPT)
fix             1 all npt temp 5.0 5.0 $(100*dt) iso 1.0 1.0 $(1000*dt)
fix             1 all npt temp 5.0 5.0 0.5 iso 1.0 1.0 $(1000*dt)
fix             1 all npt temp 5.0 5.0 0.5 iso 1.0 1.0 5
timestep        0.005

# Output including enthalpy
thermo_style    custom step temp pe ke etotal press density enthalpy vol
thermo          1000

# Equilibration
run             10000
Generated 0 of 1 mixed pair_coeff terms from geometric mixing rule
