# init
units lj
atom_style molecular
boundary p p p

read_data init.data
special_bonds lj 0.0 1.0 1.0

comm_modify cutoff 5.0

pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0

bond_style harmonic
bond_coeff 1 100.0 1.0

neighbor 3.0 bin
neigh_modify every 1 delay 0 check yes

thermo 500
thermo_style custom step temp pe ke press density

dump 1 all custom 1000 traj.lammpstrj id mol type x y z

# Phase 1: High T to mix chains into melt
fix 1 all nve/limit 0.1
fix 2 all langevin 5.0 5.0 1.0 23451
timestep 0.001
run 100000
write_restart mixed.restart

# Phase 2: Cool to ordered/glassy state
unfix 1
unfix 2
fix 1 all nvt temp 5.0 0.1 1.0
timestep 0.005
run 100000
write_restart cooled.restart
write_data cooled.data

# Phase 2.5: Equilibrate at low T
unfix 1
fix 1 all nvt temp 0.1 0.1 1.0
run 100000
write_data condensed.data

# Phase 3: Add entropy and heat to observe MELTING
compute myEntropy all entropy/atom 0.25 2.5 local no avg yes 2.5
compute avgEntropy all reduce ave c_myEntropy
thermo_style custom step temp pe ke c_avgEntropy press density
dump 2 all custom 500 entropy.lammpstrj id mol type x y z c_myEntropy

unfix 1
fix 1 all nvt temp 0.1 5.0 1.0
run 100000

# Phase 4: Equilibrate at higher T
unfix 1
fix 1 all nvt temp 5.0 5.0 1.0
run 100000

# Phase 5: Step up T 
unfix 1
fix 1 all nvt temp 4.0 4.0 1.0
run 100000

unfix 1
fix 1 all nvt temp 3.0 3.0 1.0
run 100000

unfix 1
fix 1 all nvt temp 2.0 2.0 1.0
run 100000

unfix 1
fix 1 all nvt temp 1.0 1.0 1.0
run 100000

unfix 1
fix 1 all nvt temp 0.1 0.1 1.0
run 100000


